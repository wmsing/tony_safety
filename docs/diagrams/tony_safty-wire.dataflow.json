        "无中文标时首页仍显示英文 Wire"
      ]
    },
    {
      "dot": "cyan",
      "title": "与文章分离",
      "items": [
        "Wire 不经 Admin；与 content/zh 并列进首页",
        "精读页 /wire/{id}/（EN：/en/wire/）",
        "security-feeds.json 控制源列表与 maxItems"
      ]
    }
  ]
