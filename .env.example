# 复制为 .env 后自行 export，或写入 shell 配置（本仓库不自动 load .env）
APP_ENV=development
# 本地 Admin（python -m src.admin）：HTTP Basic 用户 admin，密码为此值
ADMIN_TOKEN=change-me-before-local-admin
# 本地 npm run dev 地址（Admin「Preview」按钮跳转）
SITE_DEV_URL=http://127.0.0.1:4321/tony_safty/
# 本地 npm run translate-feed（Ollama；勿提交 .env）
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=
# TRANSLATE_CONCURRENCY=1
