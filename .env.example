# 复制为 .env 后自行 export，或写入 shell 配置（本仓库不自动 load .env）
APP_ENV=development
# 本地 Admin（python -m src.admin）：HTTP Basic 用户 admin，密码为此值
ADMIN_TOKEN=change-me-before-local-admin
# 本地 npm run dev 地址（Admin「Preview」按钮跳转）
SITE_DEV_URL=http://127.0.0.1:4321/tony_safety/
# 本地 npm run translate-feed / deep-read-feed（Ollama；勿提交 .env）
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=
# 精读专用模型（可选；未设则 deep-read-feed 回退用 OLLAMA_MODEL）
# OLLAMA_DEEP_READ_MODEL=qwen3:4b-instruct
# TRANSLATE_CONCURRENCY=1
