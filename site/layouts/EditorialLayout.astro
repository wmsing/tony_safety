---
import '../design-system/tokens.css';
import '../design-system/editorial.css';
import '../styles/overrides.css';

interface Props {
	title: string;
	description?: string;
	lang?: 'zh-CN' | 'en';
	enPath?: string;
	zhPath?: string;
}

const {
	title,
	description = 'LLM 安全主题博客与笔记',
	lang = 'zh-CN',
	enPath = '/en/',
	zhPath = '/',
} = Astro.props;

const base = import.meta.env.BASE_URL;
const home = base;
const zhHref = `${base}${zhPath.replace(/^\//, '')}`;
const enHref = `${base}${enPath.replace(/^\//, '')}`;
const feedHref = lang === 'en' ? `${base}en/` : home;
const aboutHref = lang === 'en' ? `${base}en/about/` : `${base}about/`;
const privacyHref = lang === 'en' ? `${base}en/privacy/` : `${base}privacy/`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://wmsing.github.io').href;

const basePath = base.replace(/\/$/, '');
let relPath = Astro.url.pathname;
if (basePath && relPath.startsWith(basePath)) {
	relPath = relPath.slice(basePath.length) || '/';
}
relPath = relPath.replace(/\/+$/, '') || '/';

type NavKey = 'feed' | 'about' | 'privacy';
let navActive: NavKey = 'feed';
if (relPath === '/about' || relPath === '/en/about') navActive = 'about';
else if (relPath === '/privacy' || relPath === '/en/privacy') navActive = 'privacy';

const bannerSrc = `${base}images/hero-banner.jpeg`;
const bannerAlt =
	lang === 'en'
		? 'Comic illustration: neural shield engaged against cyber attacks'
		: '漫画插图：神经网络护盾抵御网络攻击';
const tagline =
	lang === 'en'
		? 'LLM safety and abuse resistance · Chinese-first content'
		: '大模型安全与滥用防护 · 中文优先';
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#edddaf" />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title} | LLM 网络安全</title>
	</head>
	<body>
		<div class="read-progress" aria-hidden="true"></div>
		<div class="site">
			<header class="site-header">
				<div class="brand-block">
					<p class="brand"><a href={home}>LLM 网络安全</a></p>
					<p class="tagline">{tagline}</p>
				</div>
			</header>
			<img
				class="site-banner"
				src={bannerSrc}
				width={1024}
				height={571}
				alt={bannerAlt}
				loading="eager"
				decoding="async"
			/>
			<nav class="site-nav site-nav--under-banner" aria-label="Primary">
				<div class="nav-primary">
					<a
						class:list={{ 'is-active': navActive === 'feed' }}
						href={feedHref}
						aria-current={navActive === 'feed' ? 'page' : undefined}
						>{lang === 'en' ? 'Feed' : '动态'}</a
					>
					<a
						class:list={{ 'is-active': navActive === 'about' }}
						href={aboutHref}
						aria-current={navActive === 'about' ? 'page' : undefined}
						>{lang === 'en' ? 'About' : '关于'}</a
					>
					<a
						class:list={{ 'is-active': navActive === 'privacy' }}
						href={privacyHref}
						aria-current={navActive === 'privacy' ? 'page' : undefined}
						>{lang === 'en' ? 'Privacy' : '隐私'}</a
					>
				</div>
				<div class="lang-switch">
					{lang === 'zh-CN' ? (
						<a class="lang-btn lang-btn--en" href={enHref} hreflang="en" lang="en">
							EN
						</a>
					) : (
						<a class="lang-btn lang-btn--zh" href={zhHref} hreflang="zh-Hans" lang="zh-Hans">
							中
						</a>
					)}
				</div>
			</nav>
			<slot />
			<footer class="site-footer">
				<p class="meta-text">
					<a href="https://github.com/wmsing/tony_safty" target="_blank" rel="noopener noreferrer"
						>GitHub</a
					>
					{lang === 'en' ? ' · Inbox is not auto-published' : ' · Inbox 素材不自动发布'}
				</p>
			</footer>
		</div>
		<script is:inline>
			(() => {
				const bar = document.querySelector('.read-progress');
				if (!bar) return;
				const onScroll = () => {
					const h = document.documentElement;
					const max = h.scrollHeight - h.clientHeight;
					const p = max > 0 ? h.scrollTop / max : 0;
					bar.style.setProperty('--read', String(p));
				};
				onScroll();
				addEventListener('scroll', onScroll, { passive: true });
			})();
		</script>
	</body>
</html>
