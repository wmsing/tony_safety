---
import '../design-system/tokens.css';
import '../design-system/editorial.css';
import '../styles/overrides.css';

interface Props {
	title: string;
	description?: string;
	lang?: 'zh-CN' | 'en';
	enPath?: string;
	zhPath?: string;
}

const {
	title,
	description = 'LLM 安全主题博客与笔记',
	lang = 'zh-CN',
	enPath = '/en/',
	zhPath = '/',
} = Astro.props;

const base = import.meta.env.BASE_URL;
const home = base;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://wmsing.github.io').href;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#0d0f17" />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title} | LLM 网络安全</title>
	</head>
	<body>
		<div class="read-progress" aria-hidden="true"></div>
		<div class="site">
			<header class="site-header">
				<div class="brand-block">
					<p class="brand"><a href={home}>LLM 网络安全</a></p>
					<p class="tagline">大模型安全与滥用防护 · 中文优先</p>
				</div>
			</header>
			<nav class="site-nav" aria-label="Primary">
				<div class="nav-primary">
					<a href={home}>Feed</a>
				</div>
				<div class="lang-switch">
					{lang === 'zh-CN' ? (
						<a class="lang-toggle" href={`${base}${enPath.replace(/^\//, '')}`} hreflang="en">
							English
						</a>
					) : (
						<a class="lang-toggle" href={`${base}${zhPath.replace(/^\//, '')}`} hreflang="zh-Hans">
							简体中文
						</a>
					)}
				</div>
			</nav>
			<slot />
			<footer class="site-footer">
				<p class="meta-text">
					<a href="https://github.com/wmsing/tony_safty" target="_blank" rel="noopener noreferrer"
						>GitHub</a
					>
					· Inbox 素材不自动发布
				</p>
			</footer>
		</div>
		<script is:inline>
			(() => {
				const bar = document.querySelector('.read-progress');
				if (!bar) return;
				const onScroll = () => {
					const h = document.documentElement;
					const max = h.scrollHeight - h.clientHeight;
					const p = max > 0 ? h.scrollTop / max : 0;
					bar.style.setProperty('--read', String(p));
				};
				onScroll();
				addEventListener('scroll', onScroll, { passive: true });
			})();
		</script>
	</body>
</html>
