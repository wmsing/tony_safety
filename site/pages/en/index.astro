---
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import EditorialFeed from '../../components/EditorialFeed.astro';
import { renderMarkdown } from '../../lib/markdown';
import {
	buildFeed,
	feedDateLocale,
	feedRows,
	loadExternalWireItems,
	loadFeedDeep,
	wireSourceTabs,
} from '../../lib/feed';
import { getCollection } from 'astro:content';
import feedsConfig from '../../../config/security-feeds.json';

const base = import.meta.env.BASE_URL;
const articles = await getCollection('enArticles');
const digests = await getCollection('enDigests');
const wire = await loadExternalWireItems();
const wireDeep = await loadFeedDeep();

const feed = buildFeed({
	base,
	locale: 'en',
	articles,
	digests,
	wire,
	wireDeep,
	renderDescription: renderMarkdown,
});

const wireTabs = wireSourceTabs(feed, feedsConfig.feeds);
const dateLocale = feedDateLocale('en');
const rows = feedRows(feed, dateLocale);
---

<EditorialLayout
	title="LLM Security"
	lang="en"
	description="LLM security feed — articles, digests, and wire news."
	enPath="/en/"
	zhPath="/"
>
	<EditorialFeed
		{feed}
		{rows}
		{wireTabs}
		{dateLocale}
		ui={{
			filterAria: 'Feed filters',
			all: 'All',
			article: 'Articles',
			digest: 'Digests',
			empty:
				'No published English posts yet. Wire news still appears when feed-external.json is present.',
			read: 'Read',
			readWire: 'Read source',
			readDeep: 'Deep read',
		}}
	/>
</EditorialLayout>
