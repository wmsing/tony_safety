---
import EditorialLayout from '../layouts/EditorialLayout.astro';
import EditorialFeed from '../components/EditorialFeed.astro';
import { renderMarkdown } from '../lib/markdown';
import {
	buildFeed,
	feedDateLocale,
	feedRows,
	loadExternalWireItems,
	loadFeedI18n,
	wireSourceTabs,
} from '../lib/feed';
import { getCollection } from 'astro:content';
import feedsConfig from '../../config/security-feeds.json';

const base = import.meta.env.BASE_URL;
const articles = await getCollection('articles');
const digests = await getCollection('digests');
const wire = await loadExternalWireItems();
const wireI18n = await loadFeedI18n();

const feed = buildFeed({
	base,
	locale: 'zh',
	articles,
	digests,
	wire,
	wireI18n,
	renderDescription: renderMarkdown,
});

const wireTabs = wireSourceTabs(feed, feedsConfig.feeds);
const dateLocale = feedDateLocale('zh');
const rows = feedRows(feed, dateLocale);
---

<EditorialLayout title="LLM 网络安全" description="LLM 安全主题 Feed">
	<EditorialFeed
		{feed}
		{rows}
		{wireTabs}
		{dateLocale}
		ui={{
			filterAria: '栏目',
			all: '全部',
			article: '小编',
			digest: '摘要',
			empty: '暂无已发布内容。在 content/zh/articles 添加 Markdown 后重新 build。',
			read: '阅读',
			readWire: '阅读原文',
		}}
	/>
</EditorialLayout>
