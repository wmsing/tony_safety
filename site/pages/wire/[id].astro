---
import { readFile } from 'node:fs/promises';
import path from 'node:path';
import EditorialLayout from '../../layouts/EditorialLayout.astro';
import { renderDeepReadMarkdown, renderMarkdown } from '../../lib/markdown';
import { loadExternalWireItems, loadFeedDeep, loadFeedI18n } from '../../lib/feed';

export async function getStaticPaths() {
	const wireDeep = await loadFeedDeep();
	const wire = await loadExternalWireItems();
	const wireI18n = await loadFeedI18n();
	const byWireId = new Map(wire.map((item) => [item.id, item]));
	const root = process.cwd();

	const paths = [];
	for (const id of Object.keys(wireDeep)) {
		const deep = wireDeep[id];
		if (!deep?.summaryMd?.trim()) continue;
		const meta = byWireId.get(id);
		if (!meta) continue;

		let fullBodyHtml = '';
		try {
			const raw = await readFile(
				path.join(root, 'data', 'wire-deep', `${id}.md`),
				'utf8',
			);
			const m = raw.match(/^---\r?\n[\s\S]*?\r?\n---\r?\n([\s\S]*)$/);
			const body = m?.[1]?.trim() ?? '';
			if (body) fullBodyHtml = renderMarkdown(body);
		} catch {
			/* no full text */
		}

		const titleZh = wireI18n[id]?.titleZh?.trim();
		paths.push({
			params: { id },
			props: {
				meta,
				pageTitle: titleZh || meta.title,
				summaryHtml: renderDeepReadMarkdown(deep.summaryMd),
				fullBodyHtml,
			},
		});
	}
	return paths;
}

const { meta, pageTitle, summaryHtml, fullBodyHtml } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<EditorialLayout title={pageTitle} description="Wire 精读">
	<p class="meta-text"><a href={base}>← Feed</a></p>
	<div class="item-meta">
		<span class="badge badge-primary badge-source" data-source={meta.sourceId}>
			{meta.sourceLabel}
		</span>
	</div>
	<h1 class="page-title">{pageTitle}</h1>
	<main class="prose prose-markdown wire-deep-summary" set:html={summaryHtml} />
	<p class="item-actions">
		<a class="item-read" href={meta.url} rel="noopener noreferrer" target="_blank">
			阅读原文
		</a>
	</p>
	{
		fullBodyHtml ? (
			<details class="wire-fulltext">
				<summary>抓取正文（Markdown 渲染）</summary>
				<div class="prose prose-markdown" set:html={fullBodyHtml} />
			</details>
		) : null
	}
</EditorialLayout>

<style>
	.wire-fulltext {
		margin-top: 2rem;
	}
	.wire-fulltext summary {
		cursor: pointer;
		margin-bottom: 1rem;
	}
</style>
